[Unit]
Description=Jetson AI-Showcase (Demo-Webapp)
After=network-online.target

[Service]
WorkingDirectory=%h/jetson-ai-showcase
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 -m uvicorn app.app:app --host 0.0.0.0 --port 8443 --ws-max-size 2100000 --ssl-keyfile certs/key.pem --ssl-certfile certs/cert.pem
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
